<div class="flex items-start justify-center w-full min-h-screen pt-[160px]">
  <div class="w-full max-w-md p-6 shadow-lg bg-foreground rounded-xl text-grey-text">
    <h1 class="mb-2 text-xl font-bold text-center">Create your account</h1>
    <h1 class="mb-6 text-sm text-center">Start making your dreams come true</h1>

    <%= form_with model: @user, url: sign_up_path, class: "space-y-4", data: { turbo: false } do |form| %>
      <% errors = form.object.errors %>
      <% email_error = errors.full_messages_for(:email).first %>
      <% username_error = errors.full_messages_for(:username).first %>
      <% password_error = errors.full_messages_for(:password).first %>
      <% password_conf_error = errors.full_messages_for(:password_confirmation).first %>

      <div class="space-y-2">
        <%= form.label :email %>
        <%= form.email_field :email, placeholder: 'your_email@email.com', autofocus: true, required: true, class: input_styles %>

        <% if email_error.present? %>
          <p class="text-sm text-red-500"><%= email_error %></p>
        <% end %>
      </div>

      <div class="space-y-2">
        <%= form.label :username %>
        <%= form.text_field :username, placeholder: 'Username', required: true, class: input_styles %>

        <% if username_error.present? %>
          <p class="text-sm text-red-500"><%= username_error %></p>
        <% end %>
      </div>

      <div class="space-y-2">
        <%= form.label :password %>
        <%= form.password_field :password, placeholder: 'Password', required: true, class: input_styles %>

        <% if password_error.present? %>
          <p class="text-sm text-red-500"><%= password_error %></p>
        <% end %>
      </div>

      <div style="position: absolute; left: -9999px;" aria-hidden="true">
        <%= form.label :website, "Website" %>
        <%= form.text_field :website, tabindex: "-1", autocomplete: "off" %>
      </div>

      <div class="mb-4 space-y-2">
        <%= form.label :password_confirmation %>
        <%= form.password_field :password_confirmation, placeholder: 'Password Confirmation', required: true, class: input_styles %>

        <% if password_conf_error.present? %>
          <p class="text-sm text-red-500"><%= password_conf_error %></p>
        <% end %>
      </div>

      <div class="flex flex-col items-center w-full">
        <%= form.submit 'Create Account',
            class: 'w-full py-2 px-4 mt-2 bg-accent-50 text-background cursor-pointer rounded-md transition duration-300' %>

        <%= link_to 'Log in', login_path, class: 'mt-4' %>
      </div>
    <% end %>
  </div>
</div>
