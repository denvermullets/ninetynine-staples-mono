<%# locals: (menu:) %>
<%# one desktop dropdown of the main nav - see NavHelper for the menus %>
<div data-controller="dropdown" class="relative">
  <button
    data-action="click->dropdown#toggle"
    class="<%= nav_menu_classes(menu) %> cursor-pointer flex items-center gap-1.5"
  >
    <%= menu[:label] %>
    <%= unread_badge(menu[:badge]) if menu[:badge] %>

    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"
      />
    </svg>
  </button>

  <div
    data-dropdown-target="menu"
    class="
      hidden absolute left-0 mt-2 py-2 bg-nav border border-gray-700
      rounded-lg shadow-lg z-50 min-w-max
    "
  >
    <% menu[:items].each do |item| %>
      <% if item[:heading] %>
        <div class="my-1 border-t border-gray-700"></div>
        <div
          class="
            px-4 py-1 text-xs font-semibold text-gray-500 uppercase
            tracking-wider
          "
        >
          <%= item[:heading] %>
        </div>
      <% else %>
        <%= link_to item[:path], class: 'flex items-center gap-1.5 px-4 py-2 text-nav-text hover:text-white hover:bg-gray-700' do %>
          <%= item[:label] %>
          <%= unread_badge(item[:badge]) if item[:badge] %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
