<!-- Trade Modal -->
<div
  data-card-locations-target="tradeModal"
  class="
    fixed inset-0 z-50 flex items-center justify-center hidden bg-black
    bg-opacity-50
  "
  data-action="click->card-locations#closeTradeModal"
>
  <div
    class="
      relative w-full max-w-md p-6 mx-4 border rounded-lg bg-foreground
      border-highlight
    "
    data-action="click->card-locations#stopPropagation"
  >
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-nine-white">
        Mark for trade
        <span
          class="text-sm text-grey-text"
          data-card-locations-target="tradeCollectionName"
        ></span>
      </h3>

      <button
        data-action="click->card-locations#closeTradeModal"
        class="text-grey-text hover:text-nine-white"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <%= form_with url: update_trade_collection_magic_cards_path, method: :post, class: "flex flex-col gap-4", data: { turbo: true } do |f| %>
      <%= f.hidden_field :collection_magic_card_id, data: { card_locations_target: 'tradeRecordId' } %>

      <% if local_assigns[:row_collection_id].present? %>
        <%# the collections table is filtered to one collection, so its row only sums that one %>
        <%= f.hidden_field :row_collection_id, value: local_assigns[:row_collection_id] %>
      <% end %>

      <!-- Regular Trade Quantity -->
      <div class="p-3 border rounded-md border-highlight bg-background">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm text-grey-text">Regular:</span>

          <input
            type="number"
            name="trade_quantity"
            autocomplete="off"
            data-card-locations-target="tradeRegularNew"
            min="0"
            value="0"
            class="
              w-20 px-2 py-1 text-sm text-center border rounded-md
              border-highlight bg-foreground text-nine-white
              focus:border-accent-50 focus:ring-accent-50
            "
          >
        </div>

        <div
          class="text-xs text-grey-text"
          data-card-locations-target="tradeRegularOwned"
        ></div>
      </div>

      <!-- Foil Trade Quantity -->
      <div class="p-3 border rounded-md border-highlight bg-background">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm text-grey-text">Foil:</span>

          <input
            type="number"
            name="trade_foil_quantity"
            autocomplete="off"
            data-card-locations-target="tradeFoilNew"
            min="0"
            value="0"
            class="
              w-20 px-2 py-1 text-sm text-center border rounded-md
              border-highlight bg-foreground text-nine-white
              focus:border-accent-50 focus:ring-accent-50
            "
          >
        </div>

        <div
          class="text-xs text-grey-text"
          data-card-locations-target="tradeFoilOwned"
        ></div>
      </div>

      <p class="text-xs text-grey-text">
        Proxies can't be traded. Counts above what you own are capped at the
        owned count.
      </p>

      <div class="flex justify-end gap-3 mt-2">
        <button
          type="button"
          data-action="click->card-locations#closeTradeModal"
          class="
            px-4 py-2 text-sm transition border rounded-md border-highlight
            text-grey-text hover:bg-background
          "
        >
          Cancel
        </button>

        <button
          type="submit"
          class="
            px-4 py-2 text-sm transition rounded-md bg-accent-50
            text-background hover:bg-nine-white
          "
        >
          Save
        </button>
      </div>
    <% end %>
  </div>
</div>
