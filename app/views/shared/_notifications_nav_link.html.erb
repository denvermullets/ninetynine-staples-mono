<%# locals: (icon: false) %>
<%# the Notifications nav link, with a badge for everything unread - a bell on desktop, a word in the mobile menu %>
<%= link_to notifications_path, class: 'inline-flex items-center gap-1.5 hover:text-white' do %>
  <% if icon %>
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-4-5.7V5a2 2 0 10-4 0v.3A6 6 0 006 11v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
      />
    </svg>
    <span class="sr-only">Notifications</span>
  <% else %>
    Notifications
  <% end %>

  <%= unread_badge %>
<% end %>
