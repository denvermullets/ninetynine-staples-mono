<div class="bg-nav px-4 md:px-12 2xl:px-64" data-controller="mobile-menu">
  <!-- Desktop/Mobile Header -->
  <div class="flex flex-row items-center justify-between h-[72px] text-white">
    <!-- Logo and Desktop Navigation -->
    <div class="flex flex-row items-center space-x-2 lg:space-x-4">
      <%= link_to '99 Staples', root_path, class: 'font-semibold pr-4 md:pr-6 text-nav-text hover:text-white' %>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex flex-row items-center space-x-2 lg:space-x-4">
        <% nav_menus.each do |menu| %>
          <%= render partial: 'shared/nav/menu', locals: { menu: menu } %>
        <% end %>

        <% unless current_user %>
          <p class="<%= nav_item_classes('/collections/') %> text-gray-500">
            Collection
          </p>
        <% end %>

        <!-- Features Link -->
        <div class="<%= nav_item_classes('/features') %>">
          <%= link_to 'Features', features_path %>
        </div>
      </div>
    </div>

    <!-- Desktop User Actions -->
    <div class="hidden md:flex flex-row space-x-6 items-center text-nav-text">
      <% if current_user %>
        <% if current_user.role.to_i == 9001 %>
          <div data-controller="admin-menu" class="relative">
            <button
              data-action="click->admin-menu#toggle"
              class="cursor-pointer focus:outline-none hover:text-white"
            >
              Admin
            </button>

            <div
              data-admin-menu-target="menu"
              class="
                absolute right-0 mt-2 hidden flex-col bg-nav border
                border-gray-700 py-2 rounded-lg shadow-lg z-50 min-w-max
              "
            >
              <!-- Deck Engine -->
              <div
                class="
                  px-4 py-1 text-xs font-semibold text-gray-500 uppercase
                  tracking-wider
                "
              >
                Deck Engine
              </div>

              <%= link_to 'Game Changers', admin_game_changers_path, class: 'block cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= link_to 'Brackets', admin_brackets_path, class: 'block cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= link_to 'Deck Rules', admin_deck_rules_path, class: 'block cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>

              <div class="my-1 border-t border-gray-700"></div>

              <!-- Jobs -->
              <div
                class="
                  px-4 py-1 text-xs font-semibold text-gray-500 uppercase
                  tracking-wider
                "
              >
                Jobs
              </div>

              <%= link_to 'Mission Control', '/jobs', class: 'block cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Ingest Cards', dashboard_ingest_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Ingest Prices', dashboard_ingest_prices_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Ingest Precon Decks', dashboard_ingest_precon_decks_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Backfill Boxset History', dashboard_backfill_boxset_history_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Trim Boxset History', dashboard_trim_boxset_history_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Backfill Price Change', dashboard_backfill_price_change_weekly_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Backfill Oracle ID', dashboard_backfill_scryfall_oracle_id_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Reset Collections', dashboard_reset_collections_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Clear Jobs', dashboard_clear_jobs_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Profile Card Roles', dashboard_profile_card_roles_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
              <%= button_to 'Ingest Oracle Tags', dashboard_ingest_oracle_tags_path, method: :post, form_class: 'w-full', class: 'w-full cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>

              <div class="my-1 border-t border-gray-700"></div>

              <!-- Data -->
              <div
                class="
                  px-4 py-1 text-xs font-semibold text-gray-500 uppercase
                  tracking-wider
                "
              >
                Data
              </div>

              <%= link_to 'Orphaned Cards', admin_orphaned_cards_path, class: 'block cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>

              <div class="my-1 border-t border-gray-700"></div>

              <!-- Settings -->
              <div
                class="
                  px-4 py-1 text-xs font-semibold text-gray-500 uppercase
                  tracking-wider
                "
              >
                Settings
              </div>

              <%= link_to 'Manage Tags', admin_tags_path, class: 'block cursor-pointer text-left whitespace-nowrap px-4 py-2 hover:text-white hover:bg-gray-700' %>
            </div>
          </div>
        <% end %>
        <%= render partial: 'shared/notifications_nav_link', locals: { icon: true } %>
        <%= link_to 'Settings', settings_path, class: 'hover:text-white' %>
        <%= link_to 'Sign out', logout_path, data: { turbo_method: :delete }, class: 'hover:text-white' %>
      <% else %>
        <%= link_to 'Log In', login_path, class: 'hover:text-white' %>
      <% end %>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      data-action="click->mobile-menu#toggle"
      class="
        md:hidden flex flex-col justify-center items-center w-8 h-8
        cursor-pointer focus:outline-none
      "
      aria-label="Toggle menu"
    >
      <span class="block w-6 h-0.5 bg-white mb-1"></span>
      <span class="block w-6 h-0.5 bg-white mb-1"></span>
      <span class="block w-6 h-0.5 bg-white"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    data-mobile-menu-target="menu"
    class="
      hidden md:hidden flex-col space-y-2 pt-2 pb-4 text-nav-text border-t
      border-gray-700
    "
  >
    <% nav_menus.each do |menu| %>
      <%= render partial: 'shared/nav/mobile_section', locals: { menu: menu } %>
    <% end %>

    <% if current_user %>
      <div class="<%= nav_item_classes('/notifications') %> px-4">
        <%= render partial: 'shared/notifications_nav_link' %>
      </div>
      <!-- Features Link -->
      <div class="<%= nav_item_classes('/features') %> px-4">
        <%= link_to 'Features', features_path %>
      </div>
      <% if current_user.role.to_i == 9001 %>
        <!-- Admin Section -->
        <div
          data-controller="collapsible"
          data-collapsible-expanded-value="false"
        >
          <button
            type="button"
            data-action="click->collapsible#toggle"
            class="
              flex items-center justify-between w-full px-4 py-2 text-left
              cursor-pointer
            "
          >
            <span class="font-semibold text-nav-text">Admin</span>

            <svg
              data-collapsible-target="icon"
              class="w-4 h-4 text-nav-text transition-transform duration-200"
              style="transform: rotate(-90deg)"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </button>

          <div data-collapsible-target="content" class="hidden pl-4 space-y-1">
            <!-- Deck Engine -->
            <div
              class="
                px-4 py-1 text-xs font-semibold text-gray-500 uppercase
                tracking-wider
              "
            >
              Deck Engine
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= link_to 'Game Changers', admin_game_changers_path %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= link_to 'Brackets', admin_brackets_path %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= link_to 'Deck Rules', admin_deck_rules_path %>
            </div>

            <!-- Jobs -->
            <div
              class="
                px-4 py-1 mt-2 text-xs font-semibold text-gray-500 uppercase
                tracking-wider
              "
            >
              Jobs
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= link_to 'Mission Control', '/jobs' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Ingest Cards', dashboard_ingest_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Ingest Prices', dashboard_ingest_prices_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Ingest Precon Decks', dashboard_ingest_precon_decks_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Backfill Boxset History', dashboard_backfill_boxset_history_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Trim Boxset History', dashboard_trim_boxset_history_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Backfill Price Change', dashboard_backfill_price_change_weekly_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Backfill Oracle ID', dashboard_backfill_scryfall_oracle_id_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Reset Collections', dashboard_reset_collections_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Clear Jobs', dashboard_clear_jobs_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= button_to 'Profile Card Roles', dashboard_profile_card_roles_path, method: :post, class: 'cursor-pointer text-left' %>
              <%= button_to 'Ingest Oracle Tags', dashboard_ingest_oracle_tags_path, method: :post, class: 'cursor-pointer text-left' %>
            </div>

            <!-- Data -->
            <div
              class="
                px-4 py-1 mt-2 text-xs font-semibold text-gray-500 uppercase
                tracking-wider
              "
            >
              Data
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= link_to 'Orphaned Cards', admin_orphaned_cards_path %>
            </div>

            <!-- Settings -->
            <div
              class="
                px-4 py-1 mt-2 text-xs font-semibold text-gray-500 uppercase
                tracking-wider
              "
            >
              Settings
            </div>

            <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
              <%= link_to 'Manage Tags', admin_tags_path %>
            </div>
          </div>
        </div>
      <% end %>
      <!-- Account Section -->
      <div
        data-controller="collapsible"
        data-collapsible-expanded-value="false"
      >
        <button
          type="button"
          data-action="click->collapsible#toggle"
          class="
            flex items-center justify-between w-full px-4 py-2 text-left
            cursor-pointer
          "
        >
          <span class="font-semibold text-nav-text">Account</span>

          <svg
            data-collapsible-target="icon"
            class="w-4 h-4 text-nav-text transition-transform duration-200"
            style="transform: rotate(-90deg)"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </button>

        <div data-collapsible-target="content" class="hidden pl-4 space-y-1">
          <div class="<%= nav_item_classes('/settings') %>">
            <%= link_to 'Settings', settings_path %>
          </div>

          <div class="px-4 py-2 rounded-3xl text-nav-text border-transparent">
            <%= link_to 'Sign out', logout_path, data: { turbo_method: :delete } %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="<%= nav_item_classes('/collections/') %> px-4 text-gray-500">
        Collection
      </div>
      <!-- Features Link -->
      <div class="<%= nav_item_classes('/features') %> px-4">
        <%= link_to 'Features', features_path %>
      </div>
      <div class="<%= nav_item_classes('/login') %> px-4">
        <%= link_to 'Log In', login_path %>
      </div>
    <% end %>
  </div>
</div>
