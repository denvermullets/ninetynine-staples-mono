<%# locals: stats - CollectionStats::SetDetail %>
<%# the links out live on the set picker above this, next to the set they act on %>
<div class="p-6 border rounded-3xl bg-foreground border-highlight">
  <p class="flex flex-wrap items-center gap-3 text-xl font-bold text-grey-text">
    <% if stats[:icon].present? %>
      <i class="<%= stats[:icon] %> text-2xl" aria-hidden="true"></i>
    <% end %>

    <%= stats[:label] %>

    <span class="text-sm font-normal text-grey-text/50">
      <%= stats[:code] %> &middot; <%= stats[:year] || 'Undated' %>
    </span>
  </p>

  <div class="grid grid-cols-2 gap-4 mt-6 md:grid-cols-3 xl:grid-cols-5">
    <%= render partial: 'collection_stats/kpi', locals: {
      label: 'Completion', tone: :accent,
      value: "#{number_with_delimiter(stats[:owned])} / #{number_with_delimiter(stats[:total])}",
      sub: "#{stats[:share]}% collected" } %>

    <%= render partial: 'collection_stats/kpi', locals: {
      label: 'With Variants',
      value: "#{number_with_delimiter(stats[:variant_owned])} / #{number_with_delimiter(stats[:variant_total])}",
      sub: "#{stats[:variant_share]}% of every printing" } %>

    <%= render partial: 'collection_stats/kpi', locals: {
      label: 'Your Copies', value: number_to_currency(stats[:value]),
      sub: 'what you hold from this set' } %>

    <%= render partial: 'collection_stats/kpi', locals: {
      label: 'Cost to Finish', value: number_to_currency(stats[:cost_to_complete]),
      sub: "#{number_with_delimiter(stats[:missing])} cards left" } %>

    <%#
      Its own tile, not a component of the one on the left. Completion asks whether you have the
      card; this asks whether you have it in foil, and somebody chasing the set in foil is answering
      a different question from somebody chasing the set. The denominator is the printings that HAVE
      a foil - a card never sold in one is not a foil you are missing.
    %>

    <%= render partial: 'collection_stats/kpi', locals: {
      label: 'Foils to Finish', value: number_to_currency(stats[:foils][:cost]),
      sub: "#{number_with_delimiter(stats[:foils][:missing])} foils left" } %>
  </div>

  <div class="h-5 mt-6 overflow-hidden rounded-full bg-background">
    <div
      class="h-full rounded-full bg-accent-50"
      style="width: <%= stats[:share] %>%"
    ></div>
  </div>

  <%#
    The rule itself has not changed - proxies still do not count as collected anywhere on this page,
    see CollectionStats::SetBasis::REAL_COPIES. It just no longer needs saying in the copy.
  %>

  <p class="mt-2 text-sm text-grey-text/50">
    Measured against <%= completion_basis_text(stats) %>.
  </p>

  <% if stats[:missing_by_rarity].any? %>
    <div class="flex flex-wrap items-center gap-2 mt-4">
      <span class="text-xs text-grey-text/50">Still missing</span>

      <% stats[:missing_by_rarity].each do |rarity, count| %>
        <span class="px-2 py-1 text-xs border rounded-full <%= rarity_chip_class(rarity) %>">
          <%= number_with_delimiter(count) %> <%= rarity %>
        </span>
      <% end %>
    </div>
  <% end %>
</div>
