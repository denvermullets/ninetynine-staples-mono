<%# locals: rows - CollectionStats::SetCards groups, labels, pagy, boxset %>
<%#
  The boxset table with two columns bolted on and one structural difference: a row here is a CARD,
  and its printings are the sub-rows inside the expansion. Column visibility rides on the boxsets
  preferences on purpose - this is the same table looked at from the collection's side, and a reader
  who hid Salt there does not want it back here. Printings and Owned are what the page is FOR, so
  they are not optional.

  The rows are hashes, not MagicCard records, so nothing in here can call a model predicate - prices
  are shown when there is a price, and CollectionSetsHelper carries the rest.
%>
<% shared_columns = %w[card_number name type mana regular_price foil_price salt] %>
<% visible_column_count = shared_columns.count { |key| column_visible?(key, 'boxsets') } + 2 %>

<div class="hidden md:block mb-24 overflow-x-auto border rounded-3xl border-highlight">
  <table class="min-w-full divide-y table-auto divide-background">
    <thead class="bg-background">
      <tr>
        <% [['card_number', '#'], ['name', 'Name'], ['type', 'Type'], ['mana', 'Mana'],
            ['regular_price', 'Regular'], ['foil_price', 'Foil'], ['salt', 'Salt']].each do |key, label| %>
          <% next unless column_visible?(key, 'boxsets') %>

          <th
            class="
              <%= key.in?(%w[type salt]) ? 'hidden lg:table-cell' : '' %>
              px-4 py-2 text-xs font-normal tracking-wider text-left normal-case
              text-grey-text
            "
          >
            <%= label %>
          </th>
        <% end %>

        <th
          class="
            px-4 py-2 text-xs font-normal tracking-wider text-left normal-case
            text-grey-text
          "
        >
          Printings
        </th>

        <th
          class="
            px-4 py-2 text-xs font-normal tracking-wider text-left normal-case
            text-grey-text
          "
        >
          Owned
        </th>
      </tr>
    </thead>

    <tbody class="bg-background" data-controller="expandable-row">
      <% rows.each do |row| %>
        <% card = row[:primary] %>

        <tr
          data-action="click->expandable-row#toggle"
          data-card-id="<%= card[:id] %>"
          class="
            border border-background text-grey-text bg-foreground
            hover:bg-menu hover:cursor-pointer <%= 'opacity-60' unless row[:owned] %>
          "
        >
          <% if column_visible?('card_number', 'boxsets') %>
            <td class="px-4 text-sm py-7 whitespace-nowrap">
              <%= card[:number] %>
            </td>
          <% end %>

          <% if column_visible?('name', 'boxsets') %>
            <td class="px-4 py-2 text-sm whitespace-nowrap">
              <i class="drop-shadow-nine py-1 rounded-xl ss ss-grad ss-<%= boxset.keyrune_code&.downcase %> ss-<%= card[:rarity]&.downcase || 'common' %> ss-fw ss-2x mr-4"></i>

              <%= row[:name].to_s.split('//').first %>
            </td>
          <% end %>

          <% if column_visible?('type', 'boxsets') %>
            <td class="hidden px-4 py-2 text-sm whitespace-nowrap lg:table-cell">
              <%= card[:card_type] %>
            </td>
          <% end %>

          <% if column_visible?('mana', 'boxsets') %>
            <td class="px-4 py-2 text-sm whitespace-nowrap">
              <div class="flex items-center m-0 space-x-1">
                <%= mana_symbols(card[:mana_cost]) %>
              </div>
            </td>
          <% end %>

          <% if column_visible?('regular_price', 'boxsets') %>
            <td class="px-4 py-2 text-sm whitespace-nowrap">
              <%= render partial: 'collection_sets/price', locals: {
                price: card[:normal_price], change: card[:change_normal] } %>
            </td>
          <% end %>

          <% if column_visible?('foil_price', 'boxsets') %>
            <td class="px-4 py-2 text-sm whitespace-nowrap">
              <%= render partial: 'collection_sets/price', locals: {
                price: card[:foil_price], change: card[:change_foil] } %>
            </td>
          <% end %>

          <% if column_visible?('salt', 'boxsets') %>
            <td class="hidden px-4 py-2 text-sm whitespace-nowrap lg:table-cell">
              <% if card[:salt].present? %>
                <%= number_with_precision(card[:salt], precision: 2) %>
              <% end %>
            </td>
          <% end %>

          <td class="px-4 py-2 text-sm whitespace-nowrap">
            <span class="<%= row[:owned_printings] == row[:total_printings] ? 'text-accent-50' : 'text-grey-text/70' %>">
              <%= row[:owned_printings] %> / <%= row[:total_printings] %>
            </span>
          </td>

          <td class="px-4 py-2 text-sm whitespace-nowrap">
            <%= owned_marker(row[:owned_qty], row[:owned_foil_qty]) || '—' %>
          </td>
        </tr>

        <tr
          data-expandable-row-target="content"
          data-card-id="<%= card[:id] %>"
          class="hidden border border-background"
        >
          <td colspan="<%= visible_column_count %>">
            <% if row[:total_printings] > 1 %>
              <%= render partial: 'collection_sets/printings', locals: {
                printings: row[:printings], labels: labels } %>
            <% end %>

            <%= turbo_frame_tag "card_details_#{card[:id]}",
                src: boxset_magic_card_path(card[:id], show_other_printings: true),
                loading: :lazy %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if pagy %>
    <div class="flex flex-row items-center justify-between w-full p-6 space-x-4">
      <%== pagy.info_tag() %>
      <%== pagy.series_nav() %>
    </div>
  <% end %>
</div>
