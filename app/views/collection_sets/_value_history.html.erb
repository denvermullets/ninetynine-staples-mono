<%# locals: set_history - Boxset#value_history or nil, owned_history - CollectionStats::SetValueHistory %>
<%#
  Two questions, one card each: what the whole set is worth, and what the copies you hold from it
  are worth - the second is today's holdings at each day's prices, so it moves with the market,
  not with your buying.

  The canvases are written out here rather than rendered from boxsets/_boxset_value_chart and
  collections/_collection_history_chart: those partials draw their own bordered box, which would
  sit as a second border inside each card. The stimulus controllers are the same ones.
%>

<div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
  <% if set_history %>
    <div
      class="p-6 border rounded-3xl bg-foreground border-highlight text-grey-text"
      data-controller="boxset-value-chart"
    >
      <h3 class="font-semibold">Set Value</h3>

      <div class="flex flex-col gap-6 mt-4 md:flex-row">
        <div class="w-full min-w-0 md:w-1/2">
          <p class="mb-2 text-xs text-grey-text/50">Normal</p>

          <canvas
            data-boxset-value-chart-target="normalChart"
            data-boxset-value-chart-normal="<%= set_history['normal'].to_json %>"
            class="w-full"
            style="max-height: 125px;"
          ></canvas>
        </div>

        <div class="w-full min-w-0 md:w-1/2">
          <p class="mb-2 text-xs text-grey-text/50">Foil</p>

          <canvas
            data-boxset-value-chart-target="foilChart"
            data-boxset-value-chart-foil="<%= set_history['foil'].to_json %>"
            class="w-full"
            style="max-height: 125px;"
          ></canvas>
        </div>
      </div>
    </div>
  <% end %>

  <% if owned_history.present? %>
    <div
      class="p-6 border rounded-3xl bg-foreground border-highlight text-grey-text"
      data-controller="collection-history-chart"
    >
      <h3 class="font-semibold">Your Copies</h3>

      <p class="mb-2 text-xs text-grey-text/50">
        The real copies you hold now, priced on each day. Proxies are not
        counted.
      </p>

      <div class="min-w-0">
        <canvas
          data-collection-history-chart-target="collectionHistoryChart"
          data-collection-history-chart-events="<%= owned_history.to_json %>"
          class="w-full"
          style="max-height: 125px;"
        ></canvas>
      </div>
    </div>
  <% end %>
</div>
