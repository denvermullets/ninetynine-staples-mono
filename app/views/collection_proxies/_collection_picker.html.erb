<%# locals: collections, selected, username, filter, location %>
<%#
  The dropdown plus this page's way back out. The picker itself is shared/_collection_picker - it is
  identical on the sets index and here, and the only thing the two disagree about is what rides on
  the link, which is why the path arrives as a proc.
%>

<div class="flex flex-wrap items-center gap-3">
  <%= render partial: "shared/collection_picker", locals: {
    collections: collections, selected: selected,
    path: ->(id) { collection_proxies_path(username, collection_id: id, filter: filter, location: location) } } %>

  <%= link_to "Collection Stats", collections_stats_path(username, collection_id: selected&.id),
    class: "px-4 py-2 border rounded-lg border-highlight text-grey-text hover:bg-foreground hover:border-accent-50 hover:text-accent-50 cursor-pointer" %>
</div>
