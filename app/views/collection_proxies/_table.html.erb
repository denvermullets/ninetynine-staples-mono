<%# locals: rows - CollectionStats::ProxyCards rows, labels, pagy %>
<%#
  A row is a PRINTING you hold a proxy of, and the collapsed row is COUNTS ONLY - how many proxies,
  how many collections they are spread over, how many real copies exist. Naming the collections here
  made the widest column the least useful one: three binder names push the badge off a laptop screen
  to say something the expansion says better, next to the art, with the quantities attached.

  So the numbers are the summary and the expansion is the detail. Foil splits go with the names for
  the same reason - "x2 + x1 foil" is a breakdown, and a breakdown belongs where there is room.

  The rows are hashes, not MagicCard records, so nothing in here can call a model predicate -
  CollectionProxiesHelper carries the presentation logic.
%>
<% column_count = 7 %>

<div class="hidden md:block mb-24 overflow-x-auto border rounded-3xl border-highlight">
  <table class="min-w-full divide-y table-auto divide-background">
    <thead class="bg-background">
      <tr>
        <% ['Name', 'Set', '#', 'Proxies', 'Collections', 'Real', ''].each do |label| %>
          <th
            class="
              px-4 py-2 text-xs font-normal tracking-wider text-left normal-case
              text-grey-text
            "
          >
            <%= label %>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody class="bg-background" data-controller="expandable-row">
      <% rows.each do |row| %>
        <% chip = proxy_status_chip(row) %>

        <tr
          data-action="click->expandable-row#toggle"
          data-card-id="<%= row[:id] %>"
          class="
            border border-background text-grey-text bg-foreground
            hover:bg-menu hover:cursor-pointer
          "
        >
          <td class="px-4 py-2 text-sm whitespace-nowrap">
            <i class="drop-shadow-nine py-1 rounded-xl ss ss-grad ss-<%= row[:keyrune]&.downcase %> ss-<%= row[:rarity]&.downcase || 'common' %> ss-fw ss-2x mr-4"></i>

            <%= row[:name].to_s.split('//').first %>

            <% if labels[row[:id]].present? %>
              <span class="ml-2 text-xs text-grey-text/50">
                <%= labels[row[:id]].join(' ') %>
              </span>
            <% end %>
          </td>

          <td class="px-4 py-2 text-sm whitespace-nowrap text-grey-text/70">
            <%= row[:set_code] %>
          </td>

          <td class="px-4 text-sm py-7 whitespace-nowrap text-grey-text/70">
            <%= row[:number] %>
          </td>

          <td class="px-4 py-2 text-sm whitespace-nowrap">
            <%= number_with_delimiter(row[:proxy_qty] + row[:proxy_foil_qty]) %>
          </td>

          <%#
            the names live on the title, so the one thing a bare count cannot tell you is still a
            hover away without costing the column any width
          %>

          <td
            class="px-4 py-2 text-sm whitespace-nowrap text-grey-text/70"
            title="<%= location_names(row[:proxy_locations], limit: 99) %>"
          >
            <%= number_with_delimiter(row[:proxy_locations].size) %>
          </td>

          <td class="px-4 py-2 text-sm whitespace-nowrap">
            <% if row[:has_real] %>
              <%= number_with_delimiter(row[:real_qty] + row[:real_foil_qty]) %>
            <% else %>
              <span class="text-grey-text/40">—</span>
            <% end %>
          </td>

          <td class="px-4 py-2 text-sm whitespace-nowrap">
            <span class="px-1.5 py-0.5 text-xs border rounded <%= chip[:class] %>">
              <%= chip[:label] %>
            </span>
          </td>
        </tr>

        <tr
          data-expandable-row-target="content"
          data-card-id="<%= row[:id] %>"
          class="hidden border border-background"
        >
          <td colspan="<%= column_count %>">
            <%= render partial: 'collection_proxies/locations', locals: { row: row, labels: labels } %>

            <%= turbo_frame_tag "card_details_#{row[:id]}",
                src: boxset_magic_card_path(row[:id], show_other_printings: true),
                loading: :lazy %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if pagy %>
    <div class="flex flex-row items-center justify-between w-full p-6 space-x-4">
      <%== pagy.info_tag() %>
      <%== pagy.series_nav() %>
    </div>
  <% end %>
</div>
