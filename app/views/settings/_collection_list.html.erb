<% if collections.empty? %>
  <p class="p-3 text-sm text-grey-text">You don't have any collections yet.</p>
<% else %>
  <% arrow_class = "p-1 rounded hover:bg-menu transition disabled:opacity-30 disabled:cursor-not-allowed" %>
  <ul class="divide-y divide-highlight">
    <% collections.each_with_index do |collection, index| %>
      <li
        draggable="true"
        data-collection-id="<%= collection.id %>"
        class="
          flex items-center gap-2 px-2 py-1 text-sm cursor-grab
          hover:bg-menu/50
        "
      >
        <svg
          class="w-4 h-4 shrink-0 text-grey-text/50"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M9 5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm6 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM9 10.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm6 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM9 16a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm6 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3z"
          ></path>
        </svg>

        <span class="w-6 text-xs text-right shrink-0 text-grey-text/50">
          <%= index + 1 %>
        </span>

        <span class="flex-1 truncate"><%= collection.name %></span>

        <span class="hidden text-xs sm:inline text-grey-text/70">
          <%= collection.collection_type.to_s.humanize %> &middot;
          <%= collection.total_cards %>
        </span>

        <div class="flex items-center shrink-0">
          <%= button_to move_collection_path, method: :post, params: { collection_id: collection.id, direction: 'top' },
              class: arrow_class,
              disabled: index == 0,
              title: "Move to top",
              data: { turbo_frame: "collection_list" } do %>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 18l7-7 7 7M5 6h14"
              ></path>
            </svg>
          <% end %>

          <%= button_to move_collection_path, method: :post, params: { collection_id: collection.id, direction: 'up' },
              class: arrow_class,
              disabled: index == 0,
              title: "Move up",
              data: { turbo_frame: "collection_list" } do %>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 15l7-7 7 7"
              ></path>
            </svg>
          <% end %>

          <%= button_to move_collection_path, method: :post, params: { collection_id: collection.id, direction: 'down' },
              class: arrow_class,
              disabled: index == collections.length - 1,
              title: "Move down",
              data: { turbo_frame: "collection_list" } do %>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
              ></path>
            </svg>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
