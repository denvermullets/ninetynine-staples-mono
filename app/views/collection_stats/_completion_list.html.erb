<%# locals: sets - CollectionStats::SetCompletion's ranked rows %>
<%# rows: [{ label:, code:, icon:, year:, owned:, total:, missing:, share:, basis:, variant_owned:, variant_total: }] %>
<div class="p-6 border rounded-3xl bg-foreground border-highlight">
  <h2 class="text-xl font-bold text-grey-text">Set Completion</h2>

  <p class="mt-1 text-sm text-grey-text/50">
    How much of each set you have, measured against its numbered run - showcase, borderless and promo
    printings are counted underneath rather than in the bar. Only sets you own a card from appear, and
    proxies count as owned, same as the card counts elsewhere on the dashboard.
  </p>

  <% if sets.any? %>
    <div class="mt-4 divide-y divide-highlight">
      <% sets.each do |row| %>
        <div class="flex items-center gap-3 py-2">
          <div class="min-w-0 shrink-0 w-28 md:w-64">
            <p class="flex items-center gap-2 text-sm text-grey-text">
              <% if row[:icon].present? %>
                <i class="<%= row[:icon] %> shrink-0" aria-hidden="true"></i>
              <% end %>

              <%#
                the set name is the way out of the panel: the boxset browser opens on a code, so a
                row you are close to finishing is one click from the list of what is in it.
                _top because this list lives inside the stats_panel frame, and a link that does not
                break out of it would try to load the whole browser into the tab.
              %>
              <%= link_to row[:label], root_path(code: row[:code]),
                data: { turbo_frame: '_top' },
                class: 'min-w-0 truncate hover:text-accent-50', title: row[:label] %>
            </p>

            <p class="text-xs truncate text-grey-text/50">
              <%= row[:year] || 'Undated' %>

              <% if row[:basis] == :all %>
                &middot; no numbered run, so every printing counts
              <% elsif row[:variant_total] != row[:total] %>
                &middot; <%= number_with_delimiter(row[:variant_owned]) %>
                of <%= number_with_delimiter(row[:variant_total]) %> with variants
              <% end %>
            </p>
          </div>

          <div class="flex-1 h-5 overflow-hidden rounded-full bg-background">
            <div class="h-full rounded-full bg-accent-50" style="width: <%= row[:share] %>%"></div>
          </div>

          <span class="text-sm text-right w-20 shrink-0 md:w-24 text-grey-text">
            <%= number_with_delimiter(row[:owned]) %> / <%= number_with_delimiter(row[:total]) %>
          </span>

          <span class="text-sm text-right w-12 shrink-0 md:w-14 text-grey-text/70">
            <%= row[:share] %>%
          </span>
        </div>
      <% end %>
    </div>
  <% end %>

  <p class="mt-4 text-sm text-grey-text/70">
    <% if sets.empty? %>
      Nothing to show here yet.
    <% else %>
      <%= number_with_delimiter(sets.sum { |row| row[:missing] }) %> cards away from finishing
      everything you have started.
    <% end %>
  </p>
</div>
