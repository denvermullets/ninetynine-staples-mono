<%# locals: title, chart_type, labels, series, tooltips %>
<%# optional: subtext, footer, palette, legend, height (pixels) %>
<%# legend: [{ label:, icon:, copies: }] - the identity channel that is not colour %>
<div class="p-6 border rounded-3xl bg-foreground border-highlight">
  <h2 class="text-xl font-bold text-grey-text"><%= title %></h2>

  <% if local_assigns[:subtext].present? %>
    <p class="mt-1 text-sm text-grey-text/50"><%= subtext %></p>
  <% end %>

  <div
    data-controller="stats-chart"
    data-stats-chart-type-value="<%= chart_type %>"
    data-stats-chart-labels-value="<%= labels.to_json %>"
    data-stats-chart-series-value="<%= series.to_json %>"
    data-stats-chart-tooltips-value="<%= tooltips.to_json %>"
    data-stats-chart-palette-value="<%= (local_assigns[:palette] || []).to_json %>"
  >
    <%# the explicit height is load-bearing: maintainAspectRatio is false, so a canvas whose
        container has no resolved height falls back to the 150px canvas default and the chart
        renders squashed. Inline rather than a Tailwind h-* class on purpose - the stylesheet
        is prebuilt, so a class that is not already compiled silently collapses the panel.
        Same idiom as collections/_collection_history_chart.html.erb %>
    <div
      class="relative w-full mt-4"
      style="height: <%= local_assigns[:height] || 256 %>px;"
    >
      <canvas data-stats-chart-target="canvas"></canvas>
    </div>

    <% if local_assigns[:legend].present? %>
      <ul class="grid grid-cols-2 mt-4 gap-x-4 gap-y-1 sm:grid-cols-3">
        <% legend.each do |item| %>
          <li class="flex items-center gap-2 text-sm text-grey-text">
            <span
              class="w-3 h-3 rounded-sm shrink-0"
              data-stats-chart-target="swatch"
            ></span>

            <%# the glyph slot keeps its width even when empty - mana-font has no multicolour
                symbol, and without this its label would sit left of every other row %>
            <span class="inline-block w-4 text-center shrink-0">
              <% if item[:icon].present? %>
                <i class="<%= item[:icon] %>" aria-hidden="true"></i>
              <% end %>
            </span>

            <span class="truncate"><%= item[:label] %></span>

            <span class="ml-auto text-grey-text/70">
              <%= number_with_delimiter(item[:copies]) %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if local_assigns[:footer].present? %>
    <p class="mt-4 text-sm text-grey-text/70"><%= footer %></p>
  <% end %>
</div>
