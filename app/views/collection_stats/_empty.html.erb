<div
  class="
    flex flex-col items-center gap-3 p-12 text-center border rounded-3xl
    bg-foreground border-highlight text-grey-text
  "
>
  <p class="text-xl font-semibold">Nothing to analyze yet</p>

  <p class="text-sm text-grey-text/70">
    <%= owner ? 'Add some cards to a collection and the breakdowns will show up here.' : "This user has no public collections." %>
  </p>

  <% if owner %>
    <%= link_to 'Browse Sets', root_path,
      class: 'px-4 py-2 mt-2 border rounded-lg border-highlight text-grey-text hover:bg-background hover:border-accent-50 hover:text-accent-50 cursor-pointer' %>
  <% end %>
</div>
