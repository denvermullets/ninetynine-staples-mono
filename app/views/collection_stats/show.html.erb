<div
  class="
    flex flex-col flex-auto h-auto px-4 pb-12 space-y-8 md:px-12 2xl:px-48
    bg-dark-100
  "
>
  <%= render partial: 'shared/page_header', locals: {
    header: @stats[:collection] ? "#{@stats[:collection].name} Analytics" : "#{@stats[:user].username}'s Collection Analytics",
    subtext: @stats[:collection] ? 'Value, composition and movement for this collection.' : 'Value, composition and movement across every collection.' } %>

  <% if @stats[:collections].any? %>
    <%= render partial: 'collection_stats/collection_picker', locals: {
      collections: @stats[:collections], selected: @stats[:collection], username: @stats[:user].username } %>
  <% end %>

  <% if @stats[:collection_ids].empty? || @stats[:overview][:total_cards].zero? %>
    <%= render partial: 'collection_stats/empty', locals: { owner: @stats[:owner] } %>
  <% else %>
    <%= render partial: 'collection_stats/kpi_grid', locals: { overview: @stats[:overview] } %>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= render partial: 'collection_stats/split_bar', locals: {
        title: 'Foil vs Non-Foil',
        left_label: 'Non-Foil', left_count: @stats[:overview][:nonfoil_cards], left_value: @stats[:overview][:nonfoil_value],
        right_label: 'Foil', right_count: @stats[:overview][:foil_cards], right_value: @stats[:overview][:foil_value] } %>

      <%= render partial: 'collection_stats/split_bar', locals: {
        title: 'Real vs Proxy',
        left_label: 'Real', left_count: @stats[:overview][:real_cards], left_value: @stats[:overview][:real_value],
        right_label: 'Proxy', right_count: @stats[:overview][:proxy_cards], right_value: @stats[:overview][:proxy_value] } %>
    </div>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= render partial: 'collection_stats/meter_panel', locals: {
        title: 'Rarity', rows: @stats[:rarity],
        subtext: 'Copies and market value held at each rarity.' } %>

      <%= render partial: 'collection_stats/meter_panel', locals: {
        title: 'Price Buckets', rows: @stats[:price_tiers][:tiers],
        subtext: 'Every copy priced individually, so a cheap non-foil and its pricey foil land in different bands.',
        footer: "#{@stats[:price_tiers][:top_tier_share]}% of your value sits in cards worth $100 or more." } %>
    </div>
    <%= render partial: 'collection_stats/meter_panel', locals: {
      title: 'Card Types', rows: @stats[:card_types][:types],
      subtext: 'A card that is both an Artifact and a Creature is counted in each row, so copies here exceed your card count.',
      footer: "#{number_with_delimiter(@stats[:card_types][:possible_commanders])} of your printings can lead a Commander deck." } %>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <% if @stats[:colors].any? %>
        <%= render partial: 'collection_stats/chart_panel', locals: {
          title: 'Colour Identity',
          subtext: 'Colour identity, counted once per card - a Golgari card is Multicolor, not one Black and one Green.',
          chart_type: 'doughnut',
          height: 300,
          labels: @stats[:colors].map { |color| color[:label] },
          series: @stats[:colors].map { |color| color[:copies] },
          palette: @stats[:colors].map { |color| color[:label].downcase },
          legend: @stats[:colors].map { |color| {
            label: color[:label],
            icon: color[:swatch] && "no-tailwind ms ms-cost #{color[:swatch]}",
            copies: color[:copies] } },
          tooltips: @stats[:colors].map { |color|
            "#{number_with_delimiter(color[:copies])} copies · #{number_to_currency(color[:value])} · #{color[:share]}%" } } %>
      <% end %>

      <%= render partial: 'collection_stats/chart_panel', locals: {
        title: 'Mana Curve',
        height: 320,
        subtext: 'Lands and tokens excluded. X is a card with no recorded mana value, not a card that costs {X}.',
        chart_type: 'bar',
        labels: @stats[:mana_curve][:buckets].map { |mv| mv[:label] },
        series: @stats[:mana_curve][:buckets].map { |mv| mv[:copies] },
        tooltips: @stats[:mana_curve][:buckets].map { |mv|
          "#{number_with_delimiter(mv[:copies])} copies · #{number_to_currency(mv[:value])}" },
        footer: "Average mana value #{@stats[:mana_curve][:average]}." } %>
    </div>

    <%= render partial: 'collection_stats/sets', locals: { sets: @stats[:sets] } %>

    <% if @stats[:history].present? %>
      <div class="flex flex-col gap-2">
        <h2 class="text-xl font-bold text-grey-text">Value Over Time</h2>

        <%= render partial: 'collections/collection_history_chart', locals: { history: @stats[:history] } %>
      </div>
    <% end %>
  <% end %>
</div>
