<div
  class="
    flex flex-col flex-auto h-auto px-4 space-y-8 md:px-12 2xl:px-48
    bg-dark-100
  "
>
  <%= render partial: 'shared/page_header',
    locals: { header: "#{@user.username}'s Decks",
              subtext: @is_owner ? 'Manage your decks. Click on a deck to enter build mode.' : "Browse #{@user.username}'s deck collection." } %>

  <div
    class="
      flex flex-col sm:flex-row justify-between items-start sm:items-center
      gap-4
    "
  >
    <% if @is_owner %>
      <div class="flex flex-wrap items-center gap-3">
        <%= link_to new_collection_path(collection_type: 'commander_deck'),
            class: 'px-4 py-2 bg-accent-50 text-background rounded-lg border border-accent-50 hover:bg-foreground hover:text-accent-50 transition cursor-pointer' do %>
          + New Deck
        <% end %>

        <%= link_to 'Compare decks', deck_compare_path,
            class: 'px-4 py-2 border border-highlight rounded-lg text-grey-text hover:bg-foreground hover:text-accent-50 hover:border-accent-50 transition cursor-pointer' %>
      </div>
    <% else %>
      <div></div>
    <% end %>

    <%= form_with url: decks_index_path(@user.username), method: :get,
        class: 'flex flex-wrap items-center gap-4' do %>
      <div class="flex items-center gap-2">
        <label for="group_by" class="text-grey-text text-sm">Group by:</label>

        <%= select_tag :group_by,
            options_for_select(Decks::Grouping::OPTIONS.map { |k, v| [v, k] }, @listing.group_by),
            class: 'border text-grey-text text-sm rounded-lg bg-background border-highlight focus:border-accent-50 focus:ring-accent-50 px-3 py-2 cursor-pointer',
            onchange: 'this.form.requestSubmit()' %>
      </div>

      <div class="flex items-center gap-2">
        <label for="sort" class="text-grey-text text-sm">Sort by:</label>

        <%= select_tag :sort,
            options_for_select(@listing.sort_options.map { |k, v| [v[:label], k] }, @listing.sort),
            class: 'border text-grey-text text-sm rounded-lg bg-background border-highlight focus:border-accent-50 focus:ring-accent-50 px-3 py-2 cursor-pointer',
            onchange: 'this.form.requestSubmit()' %>
      </div>
    <% end %>
  </div>

  <%= render partial: 'decks/deck_groups', locals: { listing: @listing } %>

  <%= turbo_frame_tag "deck_modal" %>
</div>
