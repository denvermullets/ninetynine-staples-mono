<div
  class="
    flex flex-col flex-auto h-auto px-4 space-y-8 md:px-12 2xl:px-48
    bg-dark-100
  "
>
  <%= render partial: 'shared/page_header',
    locals: { header: "#{@user.username}'s Decks",
              subtext: @is_owner ? 'Manage your decks. Click on a deck to enter build mode.' : "Browse #{@user.username}'s deck collection." } %>

  <div
    class="
      flex flex-col sm:flex-row justify-between items-start sm:items-center
      gap-4
    "
  >
    <% if @is_owner %>
      <div class="flex flex-wrap items-center gap-3">
        <%= link_to new_collection_path(collection_type: 'commander_deck'),
            class: 'px-4 py-2 bg-accent-50 text-background rounded-lg border border-accent-50 hover:bg-foreground hover:text-accent-50 transition cursor-pointer' do %>
          + New Deck
        <% end %>

        <%= link_to 'Compare decks', deck_compare_path,
            class: 'px-4 py-2 border border-highlight rounded-lg text-grey-text hover:bg-foreground hover:text-accent-50 hover:border-accent-50 transition cursor-pointer' %>
      </div>
    <% else %>
      <div></div>
    <% end %>

    <%= form_with url: decks_index_path(@user.username), method: :get,
        class: 'flex flex-wrap items-center gap-4' do %>
      <div class="flex items-center gap-2">
        <label for="group_by" class="text-grey-text text-sm">Group by:</label>

        <%= select_tag :group_by,
            options_for_select(Decks::Grouping::OPTIONS.map { |k, v| [v, k] }, @group_by),
            class: 'border text-grey-text text-sm rounded-lg bg-background border-highlight focus:border-accent-50 focus:ring-accent-50 px-3 py-2 cursor-pointer',
            onchange: 'this.form.requestSubmit()' %>
      </div>

      <div class="flex items-center gap-2">
        <label for="sort" class="text-grey-text text-sm">Sort by:</label>

        <%= select_tag :sort,
            options_for_select(@sort_options.map { |k, v| [v[:label], k] }, @sort),
            class: 'border text-grey-text text-sm rounded-lg bg-background border-highlight focus:border-accent-50 focus:ring-accent-50 px-3 py-2 cursor-pointer',
            onchange: 'this.form.requestSubmit()' %>
      </div>
    <% end %>
  </div>

  <% if @decks.any? %>
    <div class="flex flex-col gap-10">
      <% @deck_groups.each do |group| %>
        <section
          id="deck_group_<%= group.key %>"
          class="flex flex-col gap-4"
          data-controller="collapsible"
          data-collapsible-expanded-value="true"
        >
          <% if @group_by != 'none' %>
            <button
              type="button"
              data-action="click->collapsible#toggle"
              data-collapsible-target="toggle"
              aria-expanded="true"
              class="
                flex items-center gap-3 w-full pb-2 border-b border-highlight
                text-left cursor-pointer
              "
            >
              <% if (group_tag = group.tag) %>
                <span
                  class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium <%= tag_text_color_class(group_tag.color) %>"
                  style="background-color: <%= group_tag.color %>;"
                >
                  <%= group.label %>
                </span>
              <% elsif group.color_identity %>
                <span
                  class="flex items-center gap-0.5 text-lg leading-5"
                  title="Color identity: <%= group.color_identity %>"
                >
                  <%= mana_symbols(group.color_identity.chars.map { |letter| "{#{letter}}" }.join) %>
                </span>
              <% else %>
                <h2 class="text-grey-text text-lg font-medium">
                  <%= group.label %>
                </h2>
              <% end %>

              <span class="text-grey-text/70 text-sm">
                <%= pluralize(group.decks.size, 'deck') %>
              </span>

              <svg
                data-collapsible-target="icon"
                class="w-5 h-5 text-grey-text transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </button>
          <% end %>

          <div
            data-collapsible-target="content"
            class="
              grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4
              gap-6
            "
          >
            <% group.decks.each do |deck| %>
              <%= render partial: 'shared/collection_card', locals: {
                collection: deck,
                link_path: deck_builder_path(deck),
                is_owner: @is_owner,
                edit_url: edit_deck_modal_deck_builder_path(deck),
                frame_id: 'deck_modal',
                show_proxy_value: true,
                color_identity: @color_identities[deck.id],
                destroy_url: @is_owner ? confirm_destroy_collection_path(deck) : nil
              } %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="border rounded-3xl bg-foreground border-highlight p-12 text-center">
      <p class="text-lg text-grey-text mb-4">
        <% if @is_owner %>
          You don't have any decks yet.
        <% else %>
          <%= @user.username %>
          doesn't have any decks yet.
        <% end %>
      </p>

      <% if @is_owner %>
        <%= link_to 'Create Your First Deck', new_collection_path(collection_type: 'deck'),
            class: 'inline-block px-6 py-3 bg-accent-50 text-background rounded-lg border border-accent-50 hover:bg-foreground hover:text-accent-50 transition cursor-pointer' %>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "deck_modal" %>
</div>
