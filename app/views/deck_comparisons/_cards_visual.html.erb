<%# the deck builder's card stacks without its staged / needed markers; each card is a DeckComparison::Row %>
<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  <% grouped_cards.each do |group_name, cards| %>
    <div class="p-4 border rounded-xl bg-foreground border-highlight">
      <h3 class="mb-3 text-sm font-semibold text-grey-text">
        <%= group_name %> (<%= cards.sum(&:quantity) %>)
      </h3>

      <div class="relative" data-controller="card-stack">
        <% cards.each do |card| %>
          <div
            data-card-stack-target="card"
            data-action="mouseenter->card-stack#expand mouseenter->deck-compare#previewCard mouseleave->card-stack#collapse"
            data-card-image="<%= card.magic_card.image_large || card.magic_card.image_medium %>"
            data-card-name="<%= card.magic_card.name %>"
            class="relative cursor-pointer rounded-2xl overflow-hidden"
          >
            <% if card.magic_card.image_medium.present? %>
              <%= image_tag card.magic_card.image_medium,
                alt: card.magic_card.name,
                class: "w-full rounded-2xl shadow-lg",
                loading: "lazy" %>
            <% else %>
              <div
                class="
                  flex items-center justify-center w-full h-48 rounded-2xl
                  bg-background
                "
              >
                <span class="text-sm text-grey-text">
                  <%= card.magic_card.name %>
                </span>
              </div>
            <% end %>

            <!-- Quantity Badge: "12 / 9" when the decks disagree -->
            <% if card.quantity_label != '1' %>
              <span
                class="
                  absolute px-2 py-1 text-xs font-bold rounded-full top-2
                  right-2 bg-background text-white shadow
                "
              >
                <%= card.quantity_label.include?('/') ? card.quantity_label : "x#{card.quantity_label}" %>
              </span>
            <% end %>

            <% if card.magic_card.game_changer.present? %>
              <div class="absolute top-2 left-2 flex gap-1">
                <span
                  class="
                    px-1 text-[10px] font-bold rounded bg-yellow-500/90
                    text-background shadow
                  "
                  title="Game Changer"
                >
                  &#9733;
                </span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
