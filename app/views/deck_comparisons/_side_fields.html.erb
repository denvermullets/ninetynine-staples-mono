<%# one side of the comparison. Both inputs are always submitted; the hidden source says which one the server reads %>
<% source = prefill_id ? 'deck' : 'paste'
  toggle_class = 'px-3 py-1.5 text-sm border rounded-lg border-highlight text-grey-text hover:text-white transition cursor-pointer'
  active_class = 'bg-accent-50/20 text-accent-50 border-accent-50' %>

<div class="flex flex-col gap-3">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-sm font-medium text-nine-white">
      Deck <%= side.upcase %>
    </h2>

    <% if decks.any? %>
      <div class="flex items-center gap-2">
        <% [['paste', 'Paste list'], ['deck', 'My deck']].each do |value, label| %>
          <button
            type="button"
            data-deck-compare-target="sourceButton"
            data-action="click->deck-compare#toggleSource"
            data-side="<%= side %>"
            data-source="<%= value %>"
            class="<%= toggle_class %> <%= active_class if source == value %>"
          >
            <%= label %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= f.hidden_field "#{side}_source", value: source, id: nil,
        data: { deck_compare_target: 'sourceInput', side: side } %>

  <div
    data-deck-compare-target="sourcePanel"
    data-side="<%= side %>"
    data-source="paste"
    class="<%= 'hidden' unless source == 'paste' %>"
  >
    <%= f.text_area "#{side}_text", rows: 10, id: nil,
          placeholder: "1 Sol Ring\n1 Arcane Signet\n1 Fire // Ice",
          'aria-label': "Deck #{side.upcase} card list",
          class: 'w-full p-3 text-sm border rounded-lg resize-y bg-background border-highlight text-grey-text placeholder-grey-text/50 focus:outline-none focus:border-accent-50' %>
  </div>

  <% if decks.any? %>
    <div
      data-deck-compare-target="sourcePanel"
      data-side="<%= side %>"
      data-source="deck"
      class="<%= 'hidden' unless source == 'deck' %>"
    >
      <%= f.select "#{side}_deck_id", options_from_collection_for_select(decks, :id, :name, prefill_id), {},
            id: nil, 'aria-label': "Deck #{side.upcase}",
            class: 'w-full px-3 py-1.5 text-sm border rounded-lg bg-background border-highlight text-grey-text focus:border-accent-50 focus:outline-none' %>
    </div>
  <% end %>
</div>
