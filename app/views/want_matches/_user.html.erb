<%# locals: user_matches - WantList::Matches::UserMatches %>
<%#
  One holder: who they are, how many of the viewer's wants they could trade for out of how many they
  own, and each matched printing. A holder without a public trade list still owns the card and is
  still listed, but has nothing to propose against, so the buttons make way for a note.

  A thousand-card want list makes every panel on this page thousands of rows long, so the printings
  start collapsed and the counts line is what opens them - the page is a ranking of people first,
  and the cards are what you look at once one of them is worth a closer look.

  Both propose buttons open the builder pre-filled (Trades::WantDraft); "every match" is the one
  that reaches past the holder's trade list, so it only appears when they own matches they have not
  marked.
%>

<% holder = user_matches.user %>
<% unmarked = user_matches.total_count - user_matches.tradeable_count %>

<div
  class="flex flex-col border rounded-3xl bg-foreground border-highlight"
  data-controller="collapsible"
  data-collapsible-expanded-value="false"
>
  <div
    class="
      flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between
    "
  >
    <div class="min-w-0">
      <p class="text-lg font-semibold truncate text-grey-text">
        <%= holder.username %>
      </p>

      <button
        type="button"
        data-action="click->collapsible#toggle"
        data-collapsible-target="toggle"
        aria-expanded="false"
        class="
          flex items-center gap-1.5 text-xs cursor-pointer text-grey-text/50
          hover:text-grey-text
        "
      >
        <svg
          data-collapsible-target="icon"
          class="w-3 h-3 transition-transform duration-200"
          style="transform: rotate(-90deg)"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"
          />
        </svg>
        <span>
          <%= user_matches.tradeable_count %> of
          <%= pluralize(user_matches.total_count, 'want') %> marked for trade
        </span>
      </button>
    </div>

    <div class="flex flex-wrap items-center gap-3 text-sm shrink-0">
      <% if holder.trades_public? %>
        <%= link_to 'View trade list', collection_trades_path(holder.username),
          class: 'px-3 py-1.5 border rounded-md border-highlight text-grey-text hover:border-accent-50 hover:text-accent-50',
          data: { turbo_frame: '_top' } %>
        <%= link_to 'Propose trade', new_trade_path(with: holder.username, wants: 'tradeable'),
          title: "Start a trade filled with the #{pluralize(user_matches.tradeable_count, 'want')} #{holder.username} has marked for trade.",
          class: 'px-3 py-1.5 rounded-md bg-highlight text-nine-white hover:opacity-90',
          data: { turbo_frame: '_top' } %>
        <% if unmarked.positive? %>
          <%= link_to 'Propose for every match', new_trade_path(with: holder.username, wants: 'all'),
            title: "Start a trade filled with all #{pluralize(user_matches.total_count, 'want')}, including the #{unmarked} #{holder.username} owns but has not marked for trade.",
            class: 'px-3 py-1.5 border rounded-md border-accent-50/40 text-accent-50 hover:bg-accent-50/10',
            data: { turbo_frame: '_top' } %>
        <% end %>
      <% else %>
        <span class="text-grey-text/50">No public trade list</span>
      <% end %>
    </div>
  </div>

  <div
    data-collapsible-target="content"
    class="flex flex-col border-t divide-y hidden border-highlight divide-highlight"
  >
    <% user_matches.matches.each do |match| %>
      <div class="flex items-center justify-between gap-3 px-4 py-2">
        <div class="min-w-0">
          <p class="text-sm truncate text-grey-text">
            <%= match.printing.name.to_s.split('//').first %>
          </p>

          <p class="text-xs truncate text-grey-text/50">
            <%= match.printing.boxset&.code %>
            #<%= match.printing.card_number %> ·
            <%= owned_marker(*want_match_counts(match)) %>
          </p>
        </div>

        <div class="flex items-center gap-3 text-sm shrink-0">
          <% if match.tradeable %>
            <span
              class="
                px-2 py-0.5 text-xs border rounded-full border-accent-50/40
                text-accent-50
              "
            >
              For trade
            </span>
          <% elsif match.pending? %>
            <span
              class="
                px-2 py-0.5 text-xs border rounded-full border-highlight
                text-grey-text/50
              "
            >
              Pending trade
            </span>
          <% end %>

          <span class="text-grey-text/70"><%= want_match_prices(match) %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>
