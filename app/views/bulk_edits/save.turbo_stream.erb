<% errors = (@result[:results] || []).select { |r| r[:error].present? }
   processed = @result[:processed_count] || 0
   max_error_toasts = 5 %>

<% if @result[:success] && processed.zero? %>
  <% flash.now[:type] = 'error' %>
  <%= turbo_stream.append('toasts', partial: 'shared/toast',
        locals: { message: 'Nothing to save — pick FROM, TO, and a quantity on at least one row.' }) %>
<% elsif @result[:success] %>
  <% flash.now[:type] = 'success' %>
  <%= turbo_stream.append('toasts', partial: 'shared/toast',
        locals: { message: "Saved #{processed} change#{'s' unless processed == 1}." }) %>
<% else %>
  <% flash.now[:type] = 'error' %>
  <%= turbo_stream.append('toasts', partial: 'shared/toast',
        locals: { message: "Save rolled back — #{errors.size} error#{'s' unless errors.size == 1}." }) %>
  <% errors.first(max_error_toasts).each do |row| %>
    <%= turbo_stream.append('toasts', partial: 'shared/toast',
          locals: { message: "#{row[:name] || "Card #{row[:magic_card_id]}"}: #{row[:error]}" }) %>
  <% end %>
  <% if errors.size > max_error_toasts %>
    <%= turbo_stream.append('toasts', partial: 'shared/toast',
          locals: { message: "…and #{errors.size - max_error_toasts} more." }) %>
  <% end %>
<% end %>
