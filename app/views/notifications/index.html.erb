<%#
  Every notification the signed-in user has, newest first. Each row is a button: reading one marks it
  read and goes on to whatever it is about.
%>

<div
  class="
    flex flex-col flex-auto h-auto px-4 pb-12 space-y-8 md:px-12 2xl:px-48
    bg-dark-100
  "
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <%= render partial: 'shared/page_header', locals: {
      header: 'Notifications',
      subtext: "What has happened since you last looked." } %>

    <% if @unread_count.positive? %>
      <%= button_to 'Mark all as read', read_all_notifications_path,
        method: :patch,
        class: 'px-3 py-1.5 text-sm rounded-md transition cursor-pointer bg-background text-grey-text hover:bg-menu' %>
    <% end %>
  </div>

  <% if @notifications.empty? %>
    <div
      class="
        p-12 text-center border rounded-3xl bg-foreground border-highlight
        text-grey-text
      "
    >
      <p class="text-xl font-semibold">Nothing yet</p>

      <p class="mt-2 text-sm text-grey-text/70">
        Trade offers and updates will show up here.
      </p>
    </div>
  <% else %>
    <div
      class="
        flex flex-col border divide-y rounded-3xl bg-foreground
        border-highlight divide-highlight
      "
    >
      <% @notifications.each do |notification| %>
        <%= render partial: 'notifications/row', locals: { notification: notification } %>
      <% end %>
    </div>
    <% if @pagy.last > 1 %>
      <div class="flex flex-row items-center justify-between w-full space-x-4">
        <%== @pagy.info_tag %>
        <%== @pagy.series_nav %>
      </div>
    <% end %>
  <% end %>
</div>
