<%# locals: rows - CollectionStats::SellList rows, pagy, filters, username, collection_id %>
<%#
  One row per printing and finish. Where says which collections hold the copies, so the list can be
  pulled binder by binder. CK buylist and payout are in whatever payment the filters picked.

  Clicking a row opens the same lazy card_details frame the movers table does. A printing held in
  both finishes is two rows but one frame - the details answer as card_details_<card id>, and they
  show both finishes anyway - so the frame sits under the first of them and either row opens it.
%>
<% sort = { filters: filters, username: username, collection_id: collection_id } %>
<% detailed = Set.new %>
<% th = 'px-4 py-2 text-xs font-normal tracking-wider text-left normal-case text-grey-text' %>

<div class="hidden mb-24 overflow-x-auto border md:block rounded-3xl border-highlight">
  <table class="min-w-full divide-y table-auto divide-background">
    <thead class="bg-background">
      <tr>
        <th class="w-16 <%= th %>"><span class="sr-only">Card art</span></th>

        <th class="<%= th %>"><%= sell_sort_link('name', **sort) %></th>

        <th class="<%= th %>"><%= sell_sort_link('rarity', **sort) %></th>

        <th class="<%= th %>">Where</th>

        <th class="text-right <%= th %>">
          <%= sell_sort_link('copies', **sort) %>
        </th>

        <th class="text-right <%= th %>">
          <%= sell_sort_link('price', **sort) %>
        </th>

        <th class="text-right <%= th %>">
          <%= sell_sort_link('buylist', **sort) %>
        </th>

        <th class="text-right <%= th %>">
          <%= sell_sort_link('payout', **sort) %>
        </th>
      </tr>
    </thead>

    <tbody class="bg-background" data-controller="expandable-row">
      <% rows.each do |row| %>
        <tr
          data-action="click->expandable-row#toggle"
          data-card-id="<%= row[:id] %>"
          class="
            transition-colors border border-background text-grey-text
            bg-foreground hover:bg-menu hover:cursor-pointer
          "
        >
          <td class="px-4 py-2">
            <% if row[:image].present? %>
              <%= image_tag row[:image], alt: row[:name],
                class: 'object-cover w-8 rounded h-11 max-w-none',
                data: {
                  controller: 'card-hover',
                  card_hover_image_value: row[:image_large],
                  card_hover_name_value: row[:name],
                  action: 'mouseenter->card-hover#show mouseleave->card-hover#hide mousemove->card-hover#move'
                } %>
            <% else %>
              <span class="block w-8 rounded h-11 bg-background"></span>
            <% end %>
          </td>

          <td class="px-4 py-2 text-sm">
            <p class="flex items-center gap-2 truncate">
              <%= row[:name].to_s.split('//').first %>

              <% if row[:finish] == 'foil' %>
                <span class="px-1.5 text-[10px] rounded bg-accent-50/20 text-accent-50">
                  Foil
                </span>
              <% end %>
            </p>

            <p class="flex items-center gap-1 text-xs text-grey-text/50">
              <% if (icon = movers_set_icon(row)) %>
                <i class="<%= icon %>" aria-hidden="true"></i>
              <% end %>

              <%= row[:set_name] || 'Unknown set' %>
            </p>
          </td>

          <td class="px-4 py-2 text-sm capitalize whitespace-nowrap text-grey-text/70">
            <%= row[:rarity] || '-' %>
          </td>

          <td class="px-4 py-2 text-xs text-grey-text/70">
            <%= sell_places(row) %>
          </td>

          <td class="px-4 py-2 text-sm text-right whitespace-nowrap text-grey-text/70">
            &times;<%= number_with_delimiter(row[:copies]) %>
          </td>

          <td class="px-4 py-2 text-sm text-right whitespace-nowrap text-grey-text/70">
            <%= number_to_currency(row[:price]) %>
          </td>

          <td class="px-4 py-2 text-sm text-right whitespace-nowrap text-grey-text/70">
            <%= number_to_currency(row[:buylist]) %>
          </td>

          <td class="px-4 py-2 text-sm text-right whitespace-nowrap text-accent-50">
            <%= number_to_currency(row[:payout]) %>
          </td>
        </tr>

        <% next unless detailed.add?(row[:id]) %>

        <tr
          data-expandable-row-target="content"
          data-card-id="<%= row[:id] %>"
          class="hidden border border-background"
        >
          <td colspan="8">
            <%= turbo_frame_tag "card_details_#{row[:id]}",
                src: boxset_magic_card_path(row[:id], username: username, collection_id: collection_id,
                                                      show_other_printings: true),
                loading: :lazy %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if pagy %>
    <div class="flex flex-row items-center justify-between w-full p-6 space-x-4">
      <%== pagy.info_tag() %>
      <%== pagy.series_nav() %>
    </div>
  <% end %>
</div>
