<%# locals: filters - CollectionStats::SellList filters, username, collection_id %>
<%#
  A GET form inside the sell_table frame, the same shape as the movers filters: the toggles submit
  the moment they change, the buylist range waits for Apply (or Enter). Sort and direction ride
  along as hidden fields; the page does not, so a new filter starts at page one.
%>

<% pill = 'px-3 py-1.5 text-sm rounded-md transition cursor-pointer bg-background text-grey-text hover:bg-menu has-[:checked]:bg-highlight has-[:checked]:text-nine-white' %>
<% field = 'w-24 px-2 py-1.5 text-sm border rounded-md border-highlight bg-background text-grey-text focus:border-accent-50 focus:ring-accent-50' %>
<% submit_on_change = { action: 'change->auto-submit#submit' } %>

<%= form_with url: collection_sell_path(username), method: :get,
  data: { controller: 'auto-submit' }, class: 'flex flex-col gap-3' do %>
  <%= hidden_field_tag :collection_id, collection_id if collection_id %>
  <%= hidden_field_tag :sort, filters[:sort] %>
  <%= hidden_field_tag :dir, filters[:dir] %>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
    <% [[:payment, { 'cash' => 'Cash', 'credit' => 'Store credit' }],
        [:finish, { 'both' => 'Any finish', 'normal' => 'Non-foil', 'foil' => 'Foil' }],
        [:decks, { 'skip' => 'Skip decks', 'include' => 'Include decks' }]].each do |name, options| %>
      <div class="flex flex-wrap items-center gap-2">
        <% options.each do |value, label| %>
          <label class="<%= pill %>">
            <%= radio_button_tag name, value, filters[name] == value, class: 'sr-only', data: submit_on_change %>
            <%= label %>
          </label>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center">
      <% movers_rarity_options.each do |value, icon| %>
        <label
          title="<%= value.capitalize %>"
          class="
            p-1 transition border-2 border-transparent rounded-full cursor-pointer
            has-[:checked]:border-accent-50 has-[:checked]:bg-accent-50/20
          "
        >
          <%= check_box_tag 'rarity[]', value, filters[:rarity].include?(value),
            id: nil, class: 'sr-only', data: submit_on_change %>

          <i class="no-tailwind ml-0 ss <%= icon %> ms-2x" aria-hidden="true"></i>
          <span class="sr-only"><%= value.capitalize %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex flex-wrap items-end gap-4">
    <% [[:min_buylist, 'Min CK buylist'], [:max_buylist, 'Max CK buylist']].each do |name, label| %>
      <label class="flex flex-col gap-1 text-xs text-grey-text/70">
        <%= label %>

        <%= number_field_tag name, movers_amount(filters[name]), min: 0, step: '0.01',
          placeholder: 'Any', class: field %>
      </label>
    <% end %>

    <%= submit_tag 'Apply', name: nil,
      class: 'px-3 py-1.5 text-sm rounded-md bg-highlight text-nine-white cursor-pointer' %>
  </div>

  <p class="text-xs text-grey-text/50">
    Store credit adds Card Kingdom's
    <%= number_to_percentage(CollectionStats::SellList::CREDIT_BONUS * 100, precision: 0) %>
    bonus, and the buylist range reads in whichever you pick. Proxies are left
    out. Each finish is its own row, since Card Kingdom prices them separately.
    No rarity picked counts them all.
  </p>
<% end %>
