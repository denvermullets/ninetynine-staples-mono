<%# locals: rows, pagy, filters, username, collection_id %>
<%#
  The same rows without the table: the headers become a row of sort links, and the payout leads
  each card.
%>

<div class="max-w-full mb-24 md:hidden">
  <div class="flex flex-wrap items-center gap-2 mb-3 text-sm text-grey-text">
    <span class="text-xs text-grey-text/50">Sort</span>

    <% CollectionSellHelper::SELL_SORT_HEADERS.each_key do |key| %>
      <span class="px-2 py-1 rounded-md bg-background">
        <%= sell_sort_link(key, filters: filters, username: username, collection_id: collection_id) %>
      </span>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <% rows.each do |row| %>
      <div class="p-4 border rounded-xl bg-foreground border-highlight">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <p
              class="
                flex items-center gap-2 text-sm font-semibold truncate
                text-grey-text
              "
            >
              <%= row[:name].to_s.split('//').first %>

              <% if row[:finish] == 'foil' %>
                <span
                  class="
                    px-1.5 text-[10px] font-normal rounded bg-accent-50/20
                    text-accent-50
                  "
                >
                  Foil
                </span>
              <% end %>
            </p>

            <p class="flex items-center gap-1 mt-1 text-xs text-grey-text/50">
              <% if (icon = movers_set_icon(row)) %>
                <i class="<%= icon %>" aria-hidden="true"></i>
              <% end %>

              <%= row[:set_name] || 'Unknown set' %>
            </p>
          </div>

          <span class="text-sm text-right shrink-0 text-accent-50">
            <%= number_to_currency(row[:payout]) %>
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-grey-text/50">
          <span>&times;<%= number_with_delimiter(row[:copies]) %></span>
          <span><%= number_to_currency(row[:price]) %></span>
          <span>CK <%= number_to_currency(row[:buylist]) %></span>
        </div>

        <p class="mt-1 text-xs text-grey-text/50"><%= sell_places(row) %></p>
      </div>
    <% end %>
  </div>

  <% if pagy %>
    <div
      class="
        flex flex-col w-full gap-2 px-4 py-3 mt-2 text-sm bg-foreground
        rounded-xl
      "
    >
      <div class="text-grey-text"><%== pagy.info_tag() %></div>

      <div class="overflow-x-auto"><%== pagy.series_nav() %></div>
    </div>
  <% end %>
</div>
