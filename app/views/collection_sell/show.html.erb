<%#
  Every card Card Kingdom is buying, as a pull list. Same layout as the movers page: the picker
  outside the frame, the filter form, totals and table inside it, so a filter, a sort or a page
  swaps the list and moves the URL.
%>

<div
  class="
    flex flex-col flex-auto h-auto px-4 pb-12 space-y-8 md:px-12 2xl:px-48
    bg-dark-100
  "
>
  <%= render partial: 'shared/page_header', locals: {
    header: 'Sell to Card Kingdom',
    subtext: "Every card in #{@scope[:collection]&.name || 'your collections'} that Card Kingdom is buying." } %>

  <% if @scope[:collection_ids].empty? %>
    <%= render partial: 'collection_stats/empty', locals: { owner: @scope[:owner] } %>
  <% else %>
    <% username = @scope[:user].username %>
    <% collection_id = @scope[:collection]&.id %>
    <div class="flex flex-wrap items-center gap-3">
      <%= render partial: 'shared/collection_picker', locals: {
        collections: @scope[:collections], selected: @scope[:collection],
        path: ->(id) { collection_sell_path(username, **sell_query(@filters, id)) } } %>

      <%= link_to 'Price Movers', collection_movers_path(username, collection_id: collection_id),
        class: 'px-4 py-2 border rounded-lg border-highlight text-grey-text hover:bg-foreground hover:border-accent-50 hover:text-accent-50 cursor-pointer' %>
    </div>
    <%= turbo_frame_tag 'sell_table', data: { turbo_action: 'advance' } do %>
      <div class="flex flex-col space-y-4">
        <%= render partial: 'collection_sell/filters', locals: {
          filters: @filters, username: username, collection_id: collection_id } %>

        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
          <p class="text-2xl font-semibold text-accent-50">
            <%= number_to_currency(@payout) %>

            <span class="text-sm font-normal text-grey-text/70">
              <%= sell_payment_text(@filters) %>
            </span>
          </p>

          <p class="text-sm text-grey-text/70">
            <%= pluralize(number_with_delimiter(@copies), 'copy') %> across
            <%= pluralize(number_with_delimiter(@total), 'printing') %>
          </p>
        </div>

        <% if @rows.empty? %>
          <div
            class="
              p-12 text-center border rounded-3xl bg-foreground
              border-highlight text-grey-text
            "
          >
            <p class="text-xl font-semibold">Nothing to sell</p>

            <p class="mt-2 text-sm text-grey-text/70">
              Card Kingdom is not buying any card you own that clears these
              filters.
            </p>
          </div>
        <% else %>
          <%= render partial: 'collection_sell/mobile', locals: {
            rows: @rows, pagy: @pagy, filters: @filters, username: username,
            collection_id: collection_id } %>
          <%= render partial: 'collection_sell/table', locals: {
            rows: @rows, pagy: @pagy, filters: @filters, username: username,
            collection_id: collection_id } %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
